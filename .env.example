# Copy this file to .env and fill in your own values.
# cp .env.example .env

PORT=3000
MQTT_PORT=1883

# Shared secret the ESP32 must send in the x-api-key header.
# Generate your own random string for production.
DEVICE_API_KEY=change-this-to-a-long-random-secret

# Demo role sessions (set every value locally; never commit your real .env).
# Generate DEMO_AUTH_SECRET with at least 32 random characters.
DEMO_AUTH_SECRET=
DEMO_ROLE_PASSWORD_FARMER=
DEMO_ROLE_PASSWORD_FARMER_SURESH=
DEMO_ROLE_PASSWORD_TRANSPORTER=
DEMO_ROLE_PASSWORD_WAREHOUSE=
DEMO_ROLE_PASSWORD_RETAILER=
DEMO_ROLE_PASSWORD_ADMIN=
DEMO_FARMER_NAME=Ramesh Kumar
DEMO_FARMER_SECONDARY_NAME=Suresh Kumar
DEMO_TRANSPORTER_NAME=Tamil Fresh Logistics
DEMO_WAREHOUSE_NAME=Cold Store
DEMO_RETAILER_NAME=Retailer

# Where records are stored: "local" (default, no cloud account needed)
# or "aws" (Amazon S3). See README.md for setup steps for each.
CLOUD_PROVIDER=local

# --- Only needed if CLOUD_PROVIDER=aws ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET=farm2fork-ledger
